# 霓虹夜行伺服器環境變數範例（複製為 .env 或在主機後台設定）
# 監聽埠：多數主機會自動注入 PORT
PORT=3000
# 監聽位址：容器與雲端主機請保持 0.0.0.0
HOST=0.0.0.0
# 允許的 WebSocket 來源（逗號分隔）。留空＝不限制。
# 若要限制，請包含正式網域；Android App 的來源為 https://localhost
# ALLOWED_ORIGINS=https://neon.example.com,https://localhost
ALLOWED_ORIGINS=
# 房間數上限
MAX_ROOMS=300
# 斷線保留時間（毫秒），預設 30000
RECONNECT_GRACE_MS=30000
